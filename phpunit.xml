<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            `force="true"` on the database settings matters. Without it
            PHPUnit leaves an already-exported environment variable in
            place, so a stray `DB_CONNECTION` in the shell would send the
            whole suite at the developer's real database — and
            RefreshDatabase would wipe it. Forcing the value guarantees
            the suite is hermetic no matter what the shell holds.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!--
            Run the suite against an isolated in-memory SQLite database.
            Without this the tests would connect to the real MySQL
            database from .env and RefreshDatabase would wipe live data.
        -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <!--
            The payment gateway must never reach the real SSLCZ API from
            the test suite, so demo mode is forced on.
        -->
        <env name="SSLCZ_DEMO_MODE" value="true" force="true"/>
        <env name="SSLCZ_SANDBOX" value="true" force="true"/>
    </php>
</phpunit>
